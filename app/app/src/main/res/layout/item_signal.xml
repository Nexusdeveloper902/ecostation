<?xml version="1.0" encoding="utf-8"?>
<!-- Una señal del feed: icono de resultado, título y hora. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_3"
    android:paddingBottom="@dimen/space_3">

    <FrameLayout
        android:id="@+id/signalIconTile"
        android:layout_width="@dimen/icon_tile"
        android:layout_height="@dimen/icon_tile"
        android:background="@drawable/bg_icon_tile_success">

        <ImageView
            android:id="@+id/signalIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_check"
            android:tint="@color/eco_success_text" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <co.ecostation.app.ui.EcoTextView
            android:id="@+id/signalTitle"
            style="@style/Eco.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp" />

        <co.ecostation.app.ui.EcoTextView
            android:id="@+id/signalMeta"
            style="@style/Eco.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <co.ecostation.app.ui.EcoTextView
            android:id="@+id/signalCue"
            style="@style/Eco.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
