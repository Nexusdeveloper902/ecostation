<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de historial: chip de material + hora + insignia de puntos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_3"
    android:paddingBottom="@dimen/space_3">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <co.ecostation.app.ui.EcoTextView
            android:id="@+id/depositMaterial"
            style="@style/Eco.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_plastic"
            android:drawableStart="@drawable/ic_dot_plastic"
            android:drawablePadding="6dp"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/eco_ink"
            android:textSize="13sp" />

        <co.ecostation.app.ui.EcoTextView
            android:id="@+id/depositMeta"
            style="@style/Eco.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <co.ecostation.app.ui.EcoTextView
        android:id="@+id/depositPoints"
        style="@style/Eco.Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:background="@drawable/bg_badge_points"
        android:drawableStart="@drawable/ic_star"
        android:drawablePadding="5dp"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textColor="@color/eco_ink"
        android:textSize="14sp" />
</LinearLayout>
