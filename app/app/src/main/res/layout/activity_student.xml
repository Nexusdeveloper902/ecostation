<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_mint"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================== Grupo 1: iniciar sesión ==================== -->
        <ScrollView
            android:id="@+id/loginGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_5"
                android:paddingTop="@dimen/space_3"
                android:paddingEnd="@dimen/space_5"
                android:paddingBottom="@dimen/space_5">

                <ImageView
                    android:layout_width="@dimen/boti_login"
                    android:layout_height="@dimen/boti_login"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_4"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:src="@drawable/boti" />

                <co.ecostation.app.ui.EcoTextView
                    style="@style/Eco.Text.H1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:gravity="center"
                    android:text="@string/student_login_title"
                    android:textSize="36sp" />

                <co.ecostation.app.ui.EcoTextView
                    style="@style/Eco.Text.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="center"
                    android:text="@string/student_login_subtitle"
                    android:textColor="@color/eco_slate" />

                <co.ecostation.app.ui.EcoTextView
                    style="@style/Eco.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    android:text="@string/student_email" />

                <co.ecostation.app.ui.EcoEditText
                    android:id="@+id/loginEmail"
                    style="@style/Eco.Input"
                    android:layout_width="match_parent"
                    android:drawableStart="@drawable/ic_mail_18"
                    android:hint="@string/student_email"
                    android:inputType="textEmailAddress" />

                <co.ecostation.app.ui.EcoTextView
                    style="@style/Eco.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/student_password" />

                <co.ecostation.app.ui.EcoEditText
                    android:id="@+id/loginPassword"
                    style="@style/Eco.Input"
                    android:layout_width="match_parent"
                    android:drawableStart="@drawable/ic_lock_18"
                    android:hint="@string/student_password"
                    android:inputType="textPassword"
                android:importantForAutofill="no" />

                <co.ecostation.app.ui.EcoButton
                    android:id="@+id/loginButton"
                    style="@style/Eco.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_5"
                    android:text="@string/student_login" />

                <co.ecostation.app.ui.EcoTextView
                    android:id="@+id/loginError"
                    style="@style/Eco.Text.Micro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="@drawable/bg_pill_danger"
                    android:padding="@dimen/space_3"
                    android:textColor="@color/eco_danger_text"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <co.ecostation.app.ui.EcoButton
                    android:id="@+id/loginLogout"
                    style="@style/Eco.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/student_logout" />

                <co.ecostation.app.ui.EcoTextView
                    style="@style/Eco.Text.Micro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    android:gravity="center"
                    android:text="@string/student_login_note" />
            </LinearLayout>
        </ScrollView>

        <!-- ================= Grupo 2: cambio obligatorio =================== -->
        <ScrollView
            android:id="@+id/changeGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <co.ecostation.app.ui.EcoTextView
                        style="@style/Eco.Text.H2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/student_change_title" />

                    <co.ecostation.app.ui.EcoTextView
                        style="@style/Eco.Text.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/student_change_note"
                        android:textColor="@color/eco_slate" />

                    <co.ecostation.app.ui.EcoTextView
                        style="@style/Eco.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_5"
                        android:text="@string/student_current_password" />

                    <co.ecostation.app.ui.EcoEditText
                        android:id="@+id/changeCurrent"
                        style="@style/Eco.Input"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/ic_lock_18"
                        android:hint="@string/student_current_password"
                        android:inputType="textPassword"
                android:importantForAutofill="no" />

                    <co.ecostation.app.ui.EcoTextView
                        style="@style/Eco.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/student_new_password" />

                    <co.ecostation.app.ui.EcoEditText
                        android:id="@+id/changeNew"
                        style="@style/Eco.Input"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/ic_lock_18"
                        android:hint="@string/student_new_password"
                        android:inputType="textPassword"
                android:importantForAutofill="no" />

                    <co.ecostation.app.ui.EcoTextView
                        style="@style/Eco.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/student_repeat_password" />

                    <co.ecostation.app.ui.EcoEditText
                        android:id="@+id/changeConfirm"
                        style="@style/Eco.Input"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/ic_lock_18"
                        android:hint="@string/student_repeat_password"
                        android:inputType="textPassword"
                android:importantForAutofill="no" />

                    <co.ecostation.app.ui.EcoButton
                        android:id="@+id/changeButton"
                        style="@style/Eco.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/space_5"
                        android:text="@string/student_change_button" />

                    <co.ecostation.app.ui.EcoTextView
                        android:id="@+id/changeError"
                        style="@style/Eco.Text.Micro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:background="@drawable/bg_pill_danger"
                        android:padding="@dimen/space_3"
                        android:textColor="@color/eco_danger_text"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <co.ecostation.app.ui.EcoButton
                        android:id="@+id/changeLogout"
                        style="@style/Eco.Button.Ghost"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/student_logout" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ================== Grupo 3: cuenta e historial ================== -->
        <LinearLayout
            android:id="@+id/accountGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/space_2"
                android:paddingEnd="@dimen/screen_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_green"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <co.ecostation.app.ui.EcoTextView
                        android:id="@+id/studentName"
                        style="@style/Eco.Text.H3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/eco_white" />

                    <co.ecostation.app.ui.EcoTextView
                        android:id="@+id/studentClass"
                        style="@style/Eco.Text.Micro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        app:ecoFont="body"
                        android:maxLines="1"
                        android:textColor="@color/card_text_soft"
                        android:textSize="14sp" />

                    <co.ecostation.app.ui.EcoTextView
                        style="@style/Eco.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/student_balance_label"
                        android:textColor="#D8F5E6" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <co.ecostation.app.ui.EcoTextView
                            android:id="@+id/balanceText"
                            style="@style/Eco.Text.Figures"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:ecoFont="mono"
                            android:textColor="@color/eco_white"
                            android:textSize="40sp" />

                        <ImageView
                            android:layout_width="@dimen/boti_balance"
                            android:layout_height="@dimen/boti_balance"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:src="@drawable/boti" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <co.ecostation.app.ui.EcoTextView
                            android:id="@+id/rankText"
                            style="@style/Eco.Text.Micro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_white"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:textColor="@color/eco_primary_strong"
                            android:visibility="gone" />

                        <co.ecostation.app.ui.EcoTextView
                            style="@style/Eco.Text.Micro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            android:background="@drawable/bg_pill_sun"
                            android:drawableStart="@drawable/ic_star"
                            android:drawablePadding="5dp"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="@string/student_week_chip"
                            android:textColor="@color/eco_ink" />
                    </LinearLayout>
                </LinearLayout>

                <co.ecostation.app.ui.EcoTextView
                    style="@style/Eco.Text.H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/student_history" />

                <co.ecostation.app.ui.EcoTextView
                    android:id="@+id/accountError"
                    style="@style/Eco.Text.Micro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/bg_pill_danger"
                    android:padding="@dimen/space_3"
                    android:textColor="@color/eco_danger_text"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!--
              El historial es el único elemento que hace scroll: el ListView
              ocupa el alto restante en vez de anidarse dentro de un ScrollView.
            -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_2"
                android:layout_weight="1"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding">

                <ListView
                    android:id="@+id/historyList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:cacheColorHint="@android:color/transparent"
                    android:divider="@color/eco_mist"
                    android:dividerHeight="1dp"
                    android:listSelector="@android:color/transparent"
                    android:scrollbars="none" />

                <co.ecostation.app.ui.EcoTextView
                    android:id="@+id/emptyHistory"
                    style="@style/Eco.Text.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="@dimen/space_5"
                    android:text="@string/student_empty"
                    android:textColor="@color/eco_slate"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/space_2"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/space_2">

                <co.ecostation.app.ui.EcoButton
                    android:id="@+id/moreButton"
                    style="@style/Eco.Button.Outline"
                    android:layout_width="match_parent"
                    android:text="@string/student_more"
                    android:visibility="gone" />

                <co.ecostation.app.ui.EcoButton
                    android:id="@+id/logoutButton"
                    style="@style/Eco.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/student_logout" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= Grupo 4: validando sesión ==================== -->
        <LinearLayout
            android:id="@+id/loadingGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_5"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:indeterminateTint="@color/eco_primary_deep" />

            <co.ecostation.app.ui.EcoTextView
                style="@style/Eco.Text.BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center"
                android:text="@string/student_loading"
                android:textColor="@color/eco_slate" />
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
