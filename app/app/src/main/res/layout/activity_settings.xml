<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_mint"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_5">

            <co.ecostation.app.ui.EcoTextView
                style="@style/Eco.Text.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_server_eyebrow" />

            <co.ecostation.app.ui.EcoTextView
                style="@style/Eco.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_server_label" />

            <co.ecostation.app.ui.EcoEditText
                android:id="@+id/serverAddress"
                style="@style/Eco.Input"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_server_18"
                android:hint="@string/settings_server_hint"
                android:inputType="textUri" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_4"
                android:paddingTop="@dimen/space_3"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <co.ecostation.app.ui.EcoTextView
                        style="@style/Eco.Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_auto"
                        android:textSize="15sp" />

                    <co.ecostation.app.ui.EcoTextView
                        style="@style/Eco.Text.Micro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_auto_caption" />
                </LinearLayout>

                <Switch
                    android:id="@+id/autoDiscover"
                    style="@style/Eco.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <co.ecostation.app.ui.EcoButton
                    android:id="@+id/testConnection"
                    style="@style/Eco.Button.Outline"
                    android:layout_width="wrap_content"
                    android:text="@string/settings_test" />

                <co.ecostation.app.ui.EcoTextView
                    android:id="@+id/connectionStatus"
                    style="@style/Eco.Text.Micro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_dot_slate"
                    android:drawablePadding="6dp"
                    android:textColor="@color/eco_slate"
                    android:textSize="13sp" />
            </LinearLayout>

            <co.ecostation.app.ui.EcoTextView
                android:id="@+id/addressError"
                style="@style/Eco.Text.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/bg_pill_danger"
                android:padding="@dimen/space_3"
                android:text="@string/settings_bad_address"
                android:textColor="@color/eco_danger_text"
                android:textSize="13sp"
                android:visibility="gone" />

            <co.ecostation.app.ui.EcoTextView
                style="@style/Eco.Text.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/settings_account_eyebrow" />

            <co.ecostation.app.ui.EcoTextView
                style="@style/Eco.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_email_label" />

            <co.ecostation.app.ui.EcoEditText
                android:id="@+id/speakerEmail"
                style="@style/Eco.Input"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_mail_18"
                android:hint="@string/settings_email_hint"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress" />

            <co.ecostation.app.ui.EcoTextView
                style="@style/Eco.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/settings_password_label" />

            <co.ecostation.app.ui.EcoEditText
                android:id="@+id/speakerPassword"
                style="@style/Eco.Input"
                android:layout_width="match_parent"
                android:drawableStart="@drawable/ic_lock_18"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <co.ecostation.app.ui.EcoButton
                android:id="@+id/saveSettings"
                style="@style/Eco.Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/settings_login_speaker" />

            <co.ecostation.app.ui.EcoTextView
                style="@style/Eco.Text.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:gravity="center"
                android:text="@string/settings_version" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
