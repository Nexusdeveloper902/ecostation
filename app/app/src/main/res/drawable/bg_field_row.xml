<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
<item android:state_pressed="true">
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/eco_success_bg" />
    <stroke android:width="1dp" android:color="@color/eco_mist" />
    <corners android:radius="12dp" />
</shape>
</item>
<item><shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/eco_white" />
    <stroke android:width="1dp" android:color="@color/eco_mist" />
    <corners android:radius="12dp" />
</shape></item>
</selector>
