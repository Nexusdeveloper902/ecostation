# Copy to .env (project root, ignored by git) to override docker-compose.yml.
# The defaults work without this file for a local demo.

# Public URL the browser will use. Use the LAN IP for phones/stations.
APP_URL=http://localhost:8000

# WebSocket port (host == container). Change it if 8081 is already taken.
REALTIME_PORT=8081

# `*` is convenient on a trusted LAN; list exact origins in production.
REALTIME_ALLOWED_ORIGINS=*

# Must match firmware/include/secrets.h READER_API_KEY. Applied on first seed only.
ECOSTATION_DEMO_READER_KEY=DemoReaderKey0000000000000000000

# Leave empty for the offline stub. Set the real key to enable DeepSeek.
DEEPSEEK_API_KEY=
RECYCLING_CLASSIFIER_DRIVER=stub

# Seed the rich demo dashboard on the first boot (1) or leave accounts only (0).
ECOSTATION_DEMO_ACTIVITY=1
