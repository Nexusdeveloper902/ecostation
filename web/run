#!/usr/bin/env bash
# Despachador de EcoStation web. Uso: ./run setup|serve|test|ci
set -euo pipefail
cd "$(dirname "$0")"

# PHP2Shell (CVE-2026-109618 / CVE-2026-109619): every runtime through
# 8.5.11 allows unauthenticated RCE. Patched: 8.5.12+. Refuse to operate.
if ! command -v php >/dev/null 2>&1; then
    echo "PHP no está instalado." >&2
    exit 1
fi

if ! php -r 'exit(PHP_VERSION_ID >= 80512 ? 0 : 1);' >/dev/null 2>&1; then
    echo "EcoStation requiere PHP 8.5.12 o superior (PHP2Shell, CVE-2026-109618/109619)." >&2
    echo "Versión actual: $(php -r 'echo PHP_VERSION;' 2>/dev/null || echo desconocida)" >&2
    exit 1
fi

usage() {
    cat >&2 <<'USO'
Uso: ./run <comando>

  setup   instala dependencias, crea .env y la base SQLite, migra y siembra
  serve   levanta la app, el feed en vivo y las tareas programadas en :8000
  test    ejecuta las pruebas (los argumentos pasan a `php artisan test`)
  ci      Pint + pruebas, igual que la integración continua

`serve` escucha solo en 127.0.0.1 por defecto. Para exponerlo en la LAN
(estaciones y teléfonos) usa ECOSTATION_LAN=1; en ese modo también se
publica `_ecostation._tcp` si avahi o python3 están disponibles.
ECOSTATION_MDNS=0/false/no/off desactiva el anuncio mDNS.
APP_DEBUG queda en false salvo ECOSTATION_DEBUG=1.
USO
    exit 2
}

serve() {
    local pids=()
    local lan=0
    local debug=false
    local mdns=0
    local bind_host="127.0.0.1"
    local realtime_port
    local allowed_origins="${REALTIME_ALLOWED_ORIGINS:-http://127.0.0.1:8000,http://localhost:8000}"

    case "$(printf '%s' "${ECOSTATION_LAN:-0}" | tr '[:upper:]' '[:lower:]')" in
        1|true|yes|on) lan=1 ;;
    esac

    if [ "${ECOSTATION_DEBUG:-0}" = "1" ]; then
        debug=true
    fi

    # Loopback by default: a dev machine must not expose the dashboard,
    # feed or reader API to the whole LAN just because `./run serve` ran.
    if [ "$lan" = "1" ]; then
        bind_host="0.0.0.0"
        # The browser's Origin carries the LAN address it used, not
        # 127.0.0.1; allow that same host:port or the WS handshake 403s.
        local lan_ip
        lan_ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
        if [ -n "$lan_ip" ]; then
            allowed_origins="$allowed_origins,http://$lan_ip:8000"
        fi
    fi

    # mDNS only makes sense for a LAN-bound service; an explicit value wins.
    if [ -n "${ECOSTATION_MDNS:-}" ]; then
        case "$(printf '%s' "$ECOSTATION_MDNS" | tr '[:upper:]' '[:lower:]')" in
            0|false|no|off) mdns=0 ;;
            *) mdns=1 ;;
        esac
    elif [ "$lan" = "1" ]; then
        mdns=1
    fi

    # The echoed WebSocket port comes from the same config the server reads.
    realtime_port="$(php artisan tinker --execute="echo (int) config('realtime.port');" 2>/dev/null | tr -dc '0-9')"
    realtime_port="${realtime_port:-8081}"

    # Preflight: sin APP_KEY fuerte el feed en vivo firmaría tokens
    # forjables. Se niega antes de levantar ningún proceso.
    if ! php artisan realtime:serve --check >/dev/null 2>&1; then
        echo "No se puede iniciar: APP_KEY está vacía o es demasiado corta (mínimo 32 bytes)." >&2
        echo "Genera una con: php artisan key:generate" >&2
        return 1
    fi

    cleanup() {
        trap - EXIT INT TERM
        local pid
        for pid in "${pids[@]:-}"; do
            # Only signal processes that are still ours and alive: a PID
            # reused after an early child exit must never be killed.
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                kill "$pid" 2>/dev/null || true
            fi
        done
        wait 2>/dev/null || true
    }
    trap cleanup EXIT INT TERM

    # APP_DEBUG is opt-in for this dev stack, regardless of .env.
    APP_DEBUG="$debug" php artisan serve --host="$bind_host" --port=8000 &
    pids+=("$!")

    APP_DEBUG="$debug" REALTIME_ALLOWED_ORIGINS="$allowed_origins" php artisan realtime:serve --host="$bind_host" --port="$realtime_port" &
    pids+=("$!")

    APP_DEBUG="$debug" php artisan schedule:work &
    pids+=("$!")

    if [ "$mdns" = "1" ]; then
        if command -v avahi-publish-service >/dev/null 2>&1; then
            avahi-publish-service EcoStation _ecostation._tcp 8000 version=1 protocol=1 api=/api &
            pids+=("$!")
        else
            echo "avahi-publish-service no encontrado: se omite el anuncio _ecostation._tcp." >&2
        fi

        if command -v python3 >/dev/null 2>&1; then
            python3 scripts/mdns/announce.py --port 8000 &
            pids+=("$!")
        else
            echo "python3 no encontrado: se omite el reanuncio mDNS." >&2
        fi
    else
        echo "Anuncio mDNS desactivado."
    fi

    echo
    if [ "$lan" = "1" ]; then
        echo "  App:     http://0.0.0.0:8000 (LAN)"
    else
        echo "  App:     http://127.0.0.1:8000 (solo local; ECOSTATION_LAN=1 para la LAN)"
    fi
    echo "  En vivo: ws://${bind_host}:${realtime_port}"
    echo "  Detener: Ctrl+C"
    echo

    # One dead child (crash, port taken, bad config) tears the whole stack
    # down instead of leaving a half-running server behind.
    local status=0
    wait -n || status=$?
    [ "$status" -eq 0 ] && status=1
    echo "Un proceso del stack terminó; cerrando los demás." >&2
    exit "$status"
}

case "${1:-}" in
    setup)
        composer install
        cp -n .env.example .env
        grep -q '^APP_KEY=.\+' .env || php artisan key:generate # no regenerar: las claves HCE se cifran con APP_KEY
        touch database/database.sqlite
        php artisan migrate --seed --force
        echo
        echo "Credenciales de demostración (solo desarrollo, cámbialas):"
        echo "  correos: admin@ecostation.test, docente@ecostation.test, estacion@ecostation.test,"
        echo "           y un estudiante por cuenta (maria@, carlos@, ana@, diego@, lucia@ecostation.test)"
        echo "  clave:   password"
        ;;
    serve) serve ;;
    test) shift; php artisan test "$@" ;;
    ci) vendor/bin/pint --test && php artisan test ;;
    *) usage ;;
esac
